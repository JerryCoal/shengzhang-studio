PORT=4318
HOST=127.0.0.1
# Preferred: use Settings > API to save the key encrypted by Windows DPAPI.
# Legacy environment key fallback only; never put a key in a VITE_ variable.
OPENAI_API_KEY=
# Optional password for a deployed single-user workspace; required on non-loopback hosts.
APP_PASSWORD=
SESSION_SECRET=
# Comma-separated frontend origins when using native clients, e.g. capacitor://localhost,https://localhost
ALLOWED_ORIGINS=
# Native builds: set this to the HTTPS API service before building.
VITE_API_BASE_URL=
# Model routing is saved by the Settings UI in data/model-settings.json.
# Price catalog: server/models.mjs. Verify against actual billing.
