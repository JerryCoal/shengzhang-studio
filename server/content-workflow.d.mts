import type { Asset, State, Project, ContentRule } from '../src/types';
import type { AccountCreationContext } from './account-creation.mjs';
export type KnowledgeKind = 'reference' | 'experience';
export type KnowledgeEntry = { id: string; revision: number; kind: KnowledgeKind; title: string; text: string; sourceUrl: string; sourceId: string; sourceType: string; accountId: string; expiresAt: string | null; active: boolean; createdAt: string; updatedAt: string };
export type KnowledgeInput = { requestId?: string; kind: KnowledgeKind; title: string; text: string; sourceUrl?: string; sourceId?: string; sourceType?: string; accountId?: string; expiresAt?: string | null };
export type KnowledgeUpdate = Partial<Omit<KnowledgeInput, 'requestId'>> & { expectedRevision: number; active?: boolean };
export type ContentBrief = { requirement: string; knowledgeIds: string[]; accountId: string; createdAt: string; updatedAt: string };
export type ContentDraftInput = { requestId: string; accountId: string; kind: 'image' | 'video'; requirement: string; title?: string; knowledgeIds?: string[] };
export type ContentBriefInput = { expectedRevision: number; requirement: string; knowledgeIds?: string[] };
export type KnowledgeSnapshot = KnowledgeEntry & { excerpt: boolean; selection: 'explicit' | 'related' };
export type KnowledgeContext = { entries: KnowledgeSnapshot[]; summary: string; accountId: string; query: string; excluded: { id: string; reason: string }[] };
export type KnowledgePreviewInput = { accountId?: string; assetId?: string; query?: string; knowledgeIds?: string[] };
export function createContentDraft(state: State, project: Project, input: ContentDraftInput, rules?: ContentRule[]): Asset;
export function updateContentBrief(state: State, project: Project, assetId: string, input: ContentBriefInput): Asset;
export function createKnowledge(state: State, project: Project, input: KnowledgeInput): KnowledgeEntry;
export function updateKnowledge(state: State, project: Project, entryId: string, input: KnowledgeUpdate): KnowledgeEntry;
export function previewKnowledge(state: State, project: Project, input?: KnowledgePreviewInput): KnowledgeContext;
export function selectKnowledge(project: Project, input?: { accountId?: string; query?: string; knowledgeIds?: string[]; now?: number; strict?: boolean }): KnowledgeContext;
export function contentProjectForAsset(project: Project, asset?: Asset | null): Project;
export function contentRequirement(asset?: Asset | null): string;
export function contentKnowledge(project: Project, asset?: Asset | null, context?: AccountCreationContext | null, query?: string): KnowledgeContext;
export function knowledgeInstructions(context?: KnowledgeContext): string;
