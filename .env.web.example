# Production: use the actual HTTPS origin (scheme + hostname, no path).
# Render automatically supplies RENDER_EXTERNAL_URL; no secret environment values are needed.
WEB_PUBLIC_ORIGIN=https://your-site.example
HOST=0.0.0.0
PORT=10000
# Do not set OPENAI_API_KEY or platform keys on the web server.
# Every user stores their own keys encrypted in their browser.
# Never enable WEB_LOCAL_TEST on a public host.
